{
  "name": "parcpilote",
  "version": "0.5.0",
  "private": true,
  "description": "Assistant de visite de parc d'attractions : prochaine étape optimisée en temps réel (MVP Disneyland Paris).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python3 e2e/run_e2e.py",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/leaflet": "1.9.22",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
